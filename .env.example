# Plantilla de configuración.
#
# Copia este archivo a `.env.local` y rellena los valores. `.env.local` está en
# .gitignore y no se sube nunca: aquí solo viven los nombres.

# ── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API, en el panel de Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor: se salta Row Level Security. Nunca en el cliente, y nunca con
# el prefijo NEXT_PUBLIC_ — ese prefijo hace que Next la incruste en el
# JavaScript que descarga el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# ── YCloud (F1) ─────────────────────────────────────────────────────────────
# Estas tres NO las usa la aplicación en marcha: las lee una sola vez el script
# `scripts/alta-canal.mjs`, que las guarda cifradas en Vault. Después, la app
# las saca de ahí a través de la referencia que queda en `channels`.
#
# Cada cliente tiene su propia cuenta de YCloud y paga sus propios mensajes.
YCLOUD_API_KEY=
# El secreto es del webhook concreto, no de la cuenta: si creas otro endpoint,
# ese trae su propio secreto.
YCLOUD_WEBHOOK_SECRET=
# En E.164, con el +.  Ejemplo: +34600111222
YCLOUD_PHONE_NUMBER=

# ── OpenRouter (F1) ─────────────────────────────────────────────────────────
# Esta sí es de la plataforma y la misma para todos los workspaces: el modelo
# lo paga la agencia, no el cliente (BLUEPRINT §7.4). Por eso vive aquí y no en
# Vault.
OPENROUTER_API_KEY=
# Verifica el identificador exacto en openrouter.ai/models
OPENROUTER_DEFAULT_MODEL=anthropic/claude-haiku-4.5

# ── Interno (F2) ────────────────────────────────────────────────────────────
# Protege /api/internal/*, que es quien vacía los lotes del buffer. Genera uno
# largo y aleatorio:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_SECRET=
